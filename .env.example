# --- App ---
PORT=3000
NODE_ENV=development

# --- Postgres ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infra_command_center

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- SSH key encryption ---
# 32-byte (64 hex char) key used to derive an AES-256-GCM key for encrypting
# stored SSH private keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSH_KEY_ENCRYPTION_SECRET=replace-with-a-64-char-hex-string

# --- Health check worker ---
HEALTH_CHECK_CONCURRENCY=5
HEALTH_CHECK_INTERVAL_MS=120000
SSH_CONNECT_TIMEOUT_MS=8000
