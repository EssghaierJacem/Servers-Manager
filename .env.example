# --- App ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API cross-origin
# (the frontend dev server, and later its deployed URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Postgres ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infra_command_center

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- SSH key encryption ---
# 32-byte (64 hex char) key used to derive an AES-256-GCM key for encrypting
# stored SSH private keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SSH_KEY_ENCRYPTION_SECRET=replace-with-a-64-char-hex-string

# --- Health check worker (hosts, via SSH) ---
HEALTH_CHECK_CONCURRENCY=5
HEALTH_CHECK_INTERVAL_MS=120000
SSH_CONNECT_TIMEOUT_MS=8000

# --- Domain check worker (DNS + WHOIS + TLS) ---
DOMAIN_CHECK_CONCURRENCY=5
DOMAIN_CHECK_INTERVAL_MS=21600000
DNS_TIMEOUT_MS=5000
WHOIS_TIMEOUT_MS=9000
TLS_TIMEOUT_MS=8000

# --- Rollback worker ---
ROLLBACK_CONCURRENCY=5

# --- Insights worker (idle hosts, orphaned domains/hosts) ---
INSIGHTS_INTERVAL_MS=86400000
